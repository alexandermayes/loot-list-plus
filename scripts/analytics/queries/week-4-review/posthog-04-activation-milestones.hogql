SELECT 'week4' AS period, 'guild_activated' AS milestone, count() AS events, uniqExact(distinct_id) AS guilds
FROM events
WHERE event = 'guild_activated' AND distinct_id LIKE 'guild:%'
  AND timestamp >= toDateTime('2026-09-18 00:00:00', 'UTC')
  AND timestamp < toDateTime('2026-09-24 00:00:00', 'UTC') + INTERVAL 1 DAY

ORDER BY
    CASE period
        WHEN 'sprint_window' THEN 0
        WHEN 'baseline_week' THEN 1
        WHEN 'week4' THEN 2
    END,
    CASE milestone
        WHEN 'raid_schedule_configured' THEN 0
        WHEN 'loot_settings_completed' THEN 1
        WHEN 'roster_threshold_reached' THEN 2
        WHEN 'guild_qualified' THEN 3
        WHEN 'first_raid_recorded' THEN 4
        WHEN 'first_loot_awarded' THEN 5
        WHEN 'guild_activated' THEN 6
    END
