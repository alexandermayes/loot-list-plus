  AND timestamp < toDateTime('2026-09-24 00:00:00', 'UTC') + INTERVAL 1 DAY

ORDER BY
    CASE period
        WHEN 'sprint_window' THEN 0
        WHEN 'baseline_week' THEN 1
        WHEN 'week4' THEN 2
    END,
    CASE step
        WHEN 'marketing_page_viewed' THEN 0
        WHEN 'landing_pageview' THEN 1
        WHEN 'marketing_cta_clicked' THEN 2
        WHEN 'landing_cta_clicked' THEN 3
        WHEN 'sign_in_clicked' THEN 4
        WHEN 'discord_oauth_started' THEN 5
        WHEN 'discord_oauth_completed' THEN 6
        WHEN 'onboarding_viewed' THEN 7
        WHEN 'guild_creation_started' THEN 8
        WHEN 'guild_creation_completed' THEN 9
        WHEN 'guild_created' THEN 10
        WHEN 'onboarding_guild_joined' THEN 11
    END
