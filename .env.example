# ===========================================
# LootList+ Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# -------------------------------------------
# Supabase (Required)
# -------------------------------------------
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# Discord Bot (Required for DM notifications)
# -------------------------------------------
# Create a bot at https://discord.com/developers/applications
# Bot needs: Send Messages permission
DISCORD_BOT_TOKEN=your-bot-token

# -------------------------------------------
# Rate Limiting (Required for production)
# -------------------------------------------
# Get these from https://upstash.com/
# Without these, API requests will fail in production
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -------------------------------------------
# Analytics (Optional)
# -------------------------------------------
# Get these from https://posthog.com/
# App works without these, but no analytics/error tracking
NEXT_PUBLIC_POSTHOG_KEY=phc_your-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -------------------------------------------
# Admin Access (Optional)
# -------------------------------------------
# Comma-separated list of Supabase user IDs that can access admin endpoints
# Without this, admin endpoints only work in development mode
SUPER_ADMIN_IDS=user-uuid-1,user-uuid-2

# -------------------------------------------
# Feedback Webhooks (Optional)
# -------------------------------------------
# Discord webhook for receiving user feedback
DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# GitHub token for creating issues from feedback (needs repo scope)
GITHUB_TOKEN=ghp_your-token

# Target repo for feedback issues, format: owner/repo
GITHUB_REPO=alexandermayes/loot-list-plus

# -------------------------------------------
# Discord Feedback Bot (Optional)
# -------------------------------------------
# These power the bot in `discord-bot/` that captures feedback posted
# directly in your Discord server (separate from the in-app feedback
# modal which uses DISCORD_FEEDBACK_WEBHOOK_URL above).
#
# See discord-bot/SETUP-FEEDBACK.md for the full setup walkthrough.

# Discord channel ID where every non-bot message gets filed as a GH issue
# with bug+user-feedback+discord-source labels. For forum channels, only
# the starter message (post body) is filed, not replies.
# Right-click the channel in Discord (Dev Mode on) → Copy Channel ID.
FEEDBACK_CHANNEL_ID=1465821927326220288

# Optional second intake channel for feature requests. Same shape, but
# resulting issues get the `enhancement` label instead of `bug`.
FEATURE_REQUEST_CHANNEL_ID=1465821483749347460

# Discord roles allowed to file issues by reacting with 🐛 in any channel.
# Server admins can always file regardless of these. Set one or both:
#   _IDS  — comma-separated role IDs (most explicit, survives role rename)
#   _NAMES — comma-separated role names, case-insensitive (easier to read)
# A member is allowed if they have ANY matching role from either list.
FEEDBACK_REACTION_ROLE_IDS=1462740661005713522,1462739904596283423
FEEDBACK_REACTION_ROLE_NAMES=

# Discord channel ID where the daily digest is posted (e.g. #ops).
# Leave blank to disable the digest post (cron still runs the backfill).
FEEDBACK_OPS_CHANNEL_ID=1465822625744949268

# Supabase access for the bot's dedupe table (bot runs on Railway,
# not via Next.js, so it reads these unprefixed names).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for auto-generating issue titles (Claude Haiku) AND for
# powering the on-demand `/help` slash command. Optional for titles (falls back
# to the first 80 chars); REQUIRED for /help (without it, /help just posts the
# "an officer will help" fallback).
ANTHROPIC_API_KEY=sk-ant-your-key

# --- /help slash command (on-demand Q&A) ---
# Users run `/help question:<text>`. The bot searches the `help_articles` table
# (Postgres full-text + fuzzy match), hands the top matches to Claude, and
# answers — or stays silent and defers to a human when it isn't confident. It
# also searches this repo's GitHub issues so it can say "known bug, tracked in
# #123". When it answers something not yet in the knowledge base, it drafts a
# new article (status pending_review) and posts it to FEEDBACK_OPS_CHANNEL_ID
# for an officer to approve with ✅ / 🗑️ (same permission model as the 🐛/💡
# reactions: admins + FEEDBACK_REACTION_ROLE_IDS/NAMES).
#
# Knowledge base: seed it from the shared help corpus (lib/help-content.ts,
# which also powers the in-app help center) by running `npm run seed:help`
# (needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY). Re-run after editing
# help-content.ts. Requires the help_articles migration to be deployed.
#
# Optional override:
#   HELP_MODEL — Claude model for answering + drafting (default:
#                claude-3-5-haiku-20241022; bump to a stronger model like
#                claude-sonnet-5 for richer answers/drafts).
# HELP_MODEL=

# -------------------------------------------
# Battle.net OAuth (Optional)
# -------------------------------------------
# Create an OAuth client at https://develop.battle.net/access/clients
# Redirect URI: https://your-domain.com/api/auth/battlenet/callback
# Scopes: wow.profile
BLIZZARD_CLIENT_ID=your-client-id
BLIZZARD_CLIENT_SECRET=your-client-secret
