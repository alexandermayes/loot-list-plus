{
  "name": "lootlist-plus",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "preinstall": "[ -z \"$NPM_RC\" ] || echo \"$NPM_RC\" > .npmrc",
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:classic": "tsx scripts/seed-classic-raids.ts",
    "seed:test": "tsx scripts/seed-test-data.ts",
    "seed:test:clean": "tsx scripts/seed-test-data.ts --clean",
    "migrate:profile": "tsx scripts/run-profile-migrations.ts",
    "setup:loot": "tsx scripts/setup-loot-database.ts",
    "fix:items": "tsx scripts/ensure-items-available.ts",
    "reseed:bwl": "tsx scripts/reseed-bwl.ts",
    "reseed:all": "tsx scripts/clean-and-reseed-all-raids.ts",
    "consolidate:items": "tsx scripts/consolidate-multi-boss-items.ts",
    "loadtest": "k6 run loadtest/k6-loadtest.js",
    "loadtest:smoke": "k6 run --vus 1 --duration 10s loadtest/k6-loadtest.js",
    "loadtest:artillery": "artillery run loadtest/artillery.yml",
    "loadtest:auth": "k6 run loadtest/k6-loadtest-auth.js",
    "loadtest:auth:stress": "k6 run --env SCENARIO=stress loadtest/k6-loadtest-auth.js",
    "test:users:create": "tsx scripts/create-test-users.ts",
    "test:users:clean": "tsx scripts/create-test-users.ts --clean",
    "seed:test:multi": "tsx scripts/seed-test-data-multiuser.ts",
    "seed:test:multi:clean": "tsx scripts/seed-test-data-multiuser.ts --clean"
  },
  "dependencies": {
    "@hugeicons-pro/core-solid-rounded": "^3.1.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.2",
    "html2canvas": "^1.4.1",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.345.2",
    "posthog-node": "^5.24.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swr": "^2.3.8",
    "wow-classic-items": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "postgres": "^3.4.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
